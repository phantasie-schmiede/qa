# Shared PHPStan baseline for PSBits extensions.
#
# The repository's Build/Quality/phpstan.neon.dist includes this file and adds
# the repo-specific parts: tmpDir (PHPStan resolves it relative to the
# including config, so it cannot live here), paths, excludePaths, optional
# ignoreErrors and the saschaegerer/phpstan-typo3 extension include (not every
# repository requires that package).
parameters:
  level: 6
  exceptions:
    # With implicitThrows=false a function without @throws is understood as
    # "throws nothing", so the thrown set of callers is driven by the callee's
    # declared @throws. This drives the CGL @throws rule, which reports a
    # missing @throws line: the docblock carries the union of the exceptions
    # thrown on all supported core majors, so a surplus line documents an
    # exception a different core reports (a line seen by a single major
    # carries a trailing "// t3:N" marker the analyser ignores). Fixing a
    # callee changes what its callers have to declare, so the throws-fix
    # converges the cascade per major and merges the per-major sets after.
    implicitThrows: false
    # Dead-catch reports are a side effect of implicitThrows=false and are
    # out of scope for the CGL.
    reportUncheckedExceptionDeadCatch: false
    # The built-in too-wide check uses supertype coverage semantics and is
    # replaced by the PSBits rule below.
    check:
      tooWideThrowType: false
services:
  -
    class: PSBits\Qa\PhpStan\ThrowsDocblockRule
    tags:
      - phpstan.rules.rule
