#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloads = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../autoload.php',
];
foreach ($autoloads as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;
        break;
    }
}

exit(PSBits\Qa\Console\Application::execute($argv));
