{
    "name": "psbits/qa",
    "description": "Shared QA infrastructure for PSBits TYPO3 extensions: test matrix scripts, Docker setup, linter and fixer configuration, custom PHP CS Fixer rules",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "require": {
        "php": "^8.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.56",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/testing-framework": "^9.5"
    },
    "suggest": {
        "psbits/crafter": "Code and file generator for PSBits TYPO3 extensions"
    },
    "autoload": {
        "psr-4": {
            "PSBits\\Qa\\": "src/"
        }
    },
    "bin": [
        "bin/qa"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyze:php": "phpstan analyse --no-progress",
        "fix:composer": "composer normalize",
        "fix:php": "php-cs-fixer fix",
        "lint:composer": "composer normalize --dry-run --diff --no-check-lock --no-update-lock",
        "lint:php": "php-cs-fixer fix --dry-run --diff",
        "test": "phpunit -c tests/phpunit.xml.dist"
    }
}
