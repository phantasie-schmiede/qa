{
    "name": "psbits/qa",
    "description": "Shared QA infrastructure for PSBits TYPO3 extensions: test matrix scripts, Docker setup, linter and fixer configuration, custom PHP CS Fixer rules",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.4",
        "ergebnis/composer-normalize": "^2.56",
        "friendsofphp/php-cs-fixer": "^3.95",
        "helmich/typo3-typoscript-lint": "^3.3",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11",
        "saschaegerer/phpstan-typo3": "^2.1 || ^3.1",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0.4",
        "symfony/process": "^6.4 || ^7.0 || ^8.0",
        "typo3/testing-framework": "^9.5"
    },
    "require-dev": {
        "typo3/cms-core": "^13.4 || ^14.3"
    },
    "suggest": {
        "psbits/crafter": "Code and file generator for PSBits TYPO3 extensions"
    },
    "autoload": {
        "psr-4": {
            "PSBits\\Qa\\": "src/"
        }
    },
    "bin": [
        "bin/qa"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build/public"
        }
    },
    "scripts": {
        "analyze:php": "phpstan analyse --no-progress",
        "fix:all": [
            "@fix:composer",
            "@fix:php"
        ],
        "fix:composer": "composer normalize",
        "fix:php": "php Resources/Quality/phpTools.php fix",
        "lint:all": [
            "@analyze:php",
            "@lint:composer",
            "@lint:php"
        ],
        "lint:composer": "composer normalize --dry-run --diff --no-check-lock --no-update-lock",
        "lint:php": "php Resources/Quality/phpTools.php lint",
        "qa": [
            "@fix:all",
            "@lint:all",
            "@test"
        ],
        "test": "phpunit -c tests/phpunit.xml.dist"
    }
}
